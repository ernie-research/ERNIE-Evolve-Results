{
 "languages": [
  "cuda_cpp"
 ],
 "target_hardware": [
  "B200",
  "LOCAL"
 ],
 "entry_point": "kernel.cu::run",
 "destination_passing_style": false,
 "dependencies": [
  "torch",
  "cutlass"
 ],
 "binding": "torch",
 "compile_options": {
  "cflags": [
   "-O3",
   "-std=c++17"
  ],
  "cuda_cflags": [
   "-O3",
   "-std=c++17",
   "--expt-relaxed-constexpr",
   "--expt-extended-lambda"
  ],
  "ld_flags": [
   "-lcuda",
   "-lcublas"
  ]
 }
}
